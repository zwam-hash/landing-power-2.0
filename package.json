{
  "name": "bi-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11",
  "workspaces": [
    "apps/web",
    "functions",
    "packages/types"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
